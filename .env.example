# Optional external evidence sources. The API still works without these keys.
GOOGLE_FACT_CHECK_API_KEY=
GNEWS_API_KEY=

# Streamlit frontend -> deployed FastAPI service. Use http://127.0.0.1:8000 locally.
# On Streamlit Community Cloud set this as a secret instead of committing it.
BACKEND_API_URL=http://127.0.0.1:8000

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:8501
LOG_LEVEL=INFO
