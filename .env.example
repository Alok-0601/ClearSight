# Optional external evidence sources. The API still works without these keys.
GOOGLE_FACT_CHECK_API_KEY=
GNEWS_API_KEY=

# Streamlit frontend -> deployed FastAPI service. Use http://127.0.0.1:8000 locally.
# On Streamlit Community Cloud set this as a secret instead of committing it.
BACKEND_API_URL=http://127.0.0.1:8000

# Extra comma-separated frontend origins allowed to call the API. Localhost,
# GitHub Pages, and the deployed Streamlit app are already allowed by default.
CORS_ORIGINS=
LOG_LEVEL=INFO

# Telegram bot (optional). The /telegram/webhook route stays disabled until both
# are set. Token from @BotFather; the secret is any random string you choose
# (letters, digits, _ and -), e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
