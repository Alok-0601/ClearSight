# Optional external evidence sources. The API still works without these keys.
GOOGLE_FACT_CHECK_API_KEY=
GNEWS_API_KEY=

# Streamlit frontend -> deployed FastAPI service. Use http://127.0.0.1:8000 locally.
# On Streamlit Community Cloud set this as a secret instead of committing it.
BACKEND_API_URL=http://127.0.0.1:8000

# Extra comma-separated frontend origins allowed to call the API. Localhost,
# GitHub Pages, and the deployed Streamlit app are already allowed by default.
CORS_ORIGINS=
LOG_LEVEL=INFO

# Telegram bot (optional). The /telegram/webhook route stays disabled until both
# are set. Token from @BotFather; the secret is any random string you choose
# (letters, digits, _ and -), e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp bot through the Vonage Messages API Sandbox (optional). The
# /whatsapp/vonage/* routes stay disabled until the API key and secret are set
# (Vonage Dashboard > API Settings). VONAGE_SIGNATURE_SECRET is the account
# signature secret from the same page; when set, webhooks must carry Vonage's
# signed JWT. VONAGE_MESSAGES_URL defaults to the sandbox endpoint
# https://messages-sandbox.nexmo.com/v1/messages.
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_SIGNATURE_SECRET=
VONAGE_MESSAGES_URL=
